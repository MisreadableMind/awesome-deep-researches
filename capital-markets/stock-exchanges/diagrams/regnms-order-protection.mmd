    style VIOL fill:#ffebee,stroke:#c62828,stroke-width:3px
    style NOTE1 fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style NOTE2 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px

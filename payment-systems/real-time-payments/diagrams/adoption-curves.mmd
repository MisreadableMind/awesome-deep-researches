    style Yes fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style No fill:#ffebee,stroke:#b71c1c,stroke-width:2px
    style Fix fill:#fff3e0,stroke:#e65100,stroke-width:2px

    style MF6 fill:#fce4ec,stroke:#880e4f,stroke-width:3px
    style E5 fill:#e8f5e9,stroke:#2e7d32,stroke-width:3px
    style Compare fill:#fff3e0,stroke:#e65100,stroke-width:2px

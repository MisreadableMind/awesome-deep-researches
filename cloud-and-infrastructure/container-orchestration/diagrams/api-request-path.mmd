    style REQ fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style RESP fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style WATCH fill:#f3e5f5,stroke:#4a148c,stroke-width:2px

    style Prop fill:#e3f2fd,stroke:#1565c0,stroke-width:3px
    style Spend fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style Theory fill:#fffde7,stroke:#f9a825,stroke-width:3px
